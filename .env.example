# RAG Knowledge Base — Environment Variable Overrides
# Format: RAG_SECTION__KEY=value
# These override values from config.yaml

# --- Ollama ---
# RAG_OLLAMA__HOST=http://127.0.0.1:11434
# RAG_OLLAMA__EMBEDDING_MODEL=nomic-embed-text
# RAG_OLLAMA__GENERATION_MODEL=mistral:7b
# RAG_OLLAMA__TIMEOUT=120
# RAG_OLLAMA__MAX_RETRIES=3

# --- Qdrant ---
# RAG_QDRANT__HOST=127.0.0.1
# RAG_QDRANT__PORT=6333
# RAG_QDRANT__GRPC_PORT=6334
# RAG_QDRANT__COLLECTION_PREFIX=rag_

# --- SQLite ---
# RAG_SQLITE__PATH=data/rag_kb.db

# --- Chunking ---
# RAG_CHUNKING__DEFAULT_SIZE=512
# RAG_CHUNKING__DEFAULT_OVERLAP=50

# --- Search ---
# RAG_SEARCH__DEFAULT_TOP_K=10
# RAG_SEARCH__DEFAULT_MODE=hybrid

# --- Generation ---
# RAG_GENERATION__MAX_CONTEXT_CHUNKS=10
# RAG_GENERATION__TEMPERATURE=0.1
# RAG_GENERATION__MAX_TOKENS=2048

# --- Logging ---
# RAG_LOGGING__LEVEL=INFO
# RAG_LOGGING__FORMAT=json
# RAG_LOGGING__FILE=logs/rag_kb.log

# --- Server ---
# RAG_SERVER__HOST=127.0.0.1
# RAG_SERVER__PORT=8000
# RAG_SERVER__API_KEY=
# RAG_SERVER__RATE_LIMIT_RPM=60
# RAG_SERVER__RATE_LIMIT_BURST=10
# RAG_SERVER__STRICT_STARTUP=false

# --- Cache ---
# RAG_CACHE__EMBEDDING_CACHE_SIZE=1000
# RAG_CACHE__ENABLED=true
